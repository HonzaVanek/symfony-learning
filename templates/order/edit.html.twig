{% extends 'base.html.twig' %}

{% block body %}
    <div class="order-form">
        <h1>Upravit objednávku</h1>

        {{ form_start(form) }}

            {{ form_row(form.customer) }}
            {{ form_row(form.total) }}

            <button class="button" type="submit">
                Uložit změny
            </button>

        {{ form_end(form) }}

        <a class="back-link" href="{{ path('order_list') }}">
            Zpět na objednávky
        </a>
    </div>
{% endblock %}