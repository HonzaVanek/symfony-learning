<h1>Nová objednávka</h1>

<form method="post">
    <label for="total">Celková cena:</label>

    <input
        type="number"
        id="total"
        name="total"
        min="0"
        required
    >

    <label for="customerName">Zákazník:</label>

    <input
        type="text"
        id="customerName"
        name="customerName"
        required
    >

    <button type="submit">
        Vytvořit objednávku
    </button>
</form>